# e-Stat API application ID.
# Register for a free account and issue an app id (appId) at:
#   https://www.e-stat.go.jp/api/
# Then paste the issued id below. Do NOT commit your real .env file.
ESTAT_APP_ID=

# Natural-language narration uses deterministic templates by default.
# Set to "true" to enable LLM phrasing (future; numbers stay artifact-derived).
NEXT_PUBLIC_ENABLE_LLM_NARRATION=false
